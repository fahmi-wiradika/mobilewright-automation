{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/core/*"],
      "@screens/*": ["src/screens/*"],
      "@components/*": ["src/components/*"],
      "@flows/*": ["src/flows/*"],
      "@fixtures": ["src/fixtures/index.ts"],
      "@data/*": ["src/data/*"],
      "@utils/*": ["src/utils/*"],
      "@config/*": ["config/*"]
    }
  },
  "include": ["src", "tests", "config", "mobilewright.config.ts"]
}